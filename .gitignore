# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物 ----------
dist/
build/

# ---------- 环境变量（可能含密钥，绝不入库） ----------
.env
.env.*
!.env.example

# ---------- 数据库与运行时数据 ----------
# backend/data/ 放的是运行时产物（trade.db、汇率缓存 fx-cache.json 等），
# 全是本机生成的数据，一律不入库；新环境部署时由服务自动创建。
backend/data/
backend/uploads/

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-error.log*

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------- 临时 ----------
tmp/
*.tmp

# ---------- 设计参考素材（仅本地参考，一律不入库） ----------
icons8-*
design-refs/
